# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Supabase (Postgres + pgvector) ---
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string.
# Use the "Transaction pooler" URI (port 6543) — the direct db.<ref>.supabase.co
# host is IPv6-only and won't resolve on most networks/CI runners.
SUPABASE_DB_URL=
# "Session pooler" URI (port 5432) — only needed for tools that require a
# session-mode connection (e.g. running migrations).
SUPABASE_DB_DIRECT_URL=

# --- LLM for the agents (any OpenAI-compatible provider; default Groq, free tier) ---
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Optional: a stronger model just for the curator synthesis
# CURATOR_MODEL=
# Optional: models for image analysis (must be vision-capable) and retrieval reranking
# VISION_MODEL=qwen/qwen3.8-27b
# RERANK_MODEL=
# Embeddings are local (fastembed, no key). First run downloads a ~120MB model.

# --- Data sources requiring a key (optional, add only if used) ---
NEWSAPI_KEY=
UNSPLASH_ACCESS_KEY=
NASA_API_KEY=
YOUTUBE_API_KEY=

# --- n8n (if self-hosting) ---
N8N_ENCRYPTION_KEY=
