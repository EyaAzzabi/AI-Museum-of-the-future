# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Supabase (Postgres + pgvector) ---
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string.
# Use the "Transaction pooler" URI (port 6543) — the direct db.<ref>.supabase.co
# host is IPv6-only and won't resolve on most networks/CI runners.
SUPABASE_DB_URL=
# "Session pooler" URI (port 5432) — only needed for tools that require a
# session-mode connection (e.g. running migrations).
SUPABASE_DB_DIRECT_URL=

# --- LLM provider (pick one) ---
OPENAI_API_KEY=

# --- Data sources requiring a key (optional, add only if used) ---
NEWSAPI_KEY=
UNSPLASH_ACCESS_KEY=
NASA_API_KEY=

# --- n8n (if self-hosting) ---
N8N_ENCRYPTION_KEY=
