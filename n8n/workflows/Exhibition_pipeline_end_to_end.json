{
  "name": "Exhibition pipeline - end to end",
  "nodes": [
    {
      "id": "ex-webhook",
      "name": "Exhibition request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "3d9a6c2e-5b1f-4e8a-9c47-0e1b2a3c4d50",
      "parameters": {
        "httpMethod": "POST",
        "path": "exhibition",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "ex-schedule",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 220],
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 9 }]
        }
      }
    },
    {
      "id": "ex-ingest",
      "name": "Ingest new data (optional)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [240, 220],
      "disabled": true,
      "parameters": {
        "source": "database",
        "workflowId": ""
      }
    },
    {
      "id": "ex-start",
      "name": "Start pipeline run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.EXHIBITION_API_URL || 'http://127.0.0.1:5000') + '/api/exhibition' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.EXHIBITION_API_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { country: ($json.body && $json.body.country) || 'Tunisia', year_from: ($json.body && $json.body.year_from) || 2020, year_to: ($json.body && $json.body.year_to) || 2026, review: ($json.body && $json.body.review) !== false, fact_check: ($json.body && $json.body.fact_check) !== false, from_run: ($json.body && $json.body.from_run) || undefined } }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "ex-start-sched",
      "name": "Start scheduled run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 220],
      "executeOnce": true,
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.EXHIBITION_API_URL || 'http://127.0.0.1:5000') + '/api/exhibition' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.EXHIBITION_API_TOKEN || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { country: 'Tunisia', year_from: 2020, year_to: 2026, review: true, fact_check: true } }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "ex-respond",
      "name": "Return run id",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [520, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.run_id ? 202 : 400 }}"
        }
      }
    },
    {
      "id": "ex-started",
      "name": "Run started?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-run",
              "leftValue": "={{ $json.run_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex-wait",
      "name": "Wait 60 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [960, 40],
      "webhookId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "ex-status",
      "name": "Get run status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 40],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.EXHIBITION_API_URL || 'http://127.0.0.1:5000') + '/api/exhibition/' + $json.run_id }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "ex-running",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 40],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-running",
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex-has-ex",
      "name": "Exhibition written?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1680, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-ex",
              "leftValue": "={{ $json.exhibition }}",
              "rightValue": "",
              "operator": { "type": "object", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex-ok",
      "name": "Exhibition summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 40],
      "parameters": {
        "jsCode": "const base = ($env.EXHIBITION_WEB_URL || $env.EXHIBITION_API_URL || 'http://127.0.0.1:5000').replace(/\\/$/, '');\nconst runId = $json.run_id;\nconst ex = $json.exhibition || {};\nconst sections = ex.sections || [];\nconst halls = sections.map((s, i) => {\n  const images = (s.artifacts || [])\n    .filter(a => a && a.image_url)\n    .map(a => ({ id: a.id, title: a.title || '', image_url: a.image_url, year: a.year ?? null }));\n  return {\n    hall: i + 1,\n    title: s.title || `Salle ${i + 1}`,\n    image_count: images.length,\n    images,\n  };\n});\nconst imageTotal = halls.reduce((n, h) => n + h.image_count, 0);\nconst museumUrl = `${base}/virtual?run=${encodeURIComponent(runId)}`;\nconst hallsUrl = `${base}/?run=${encodeURIComponent(runId)}&museum=1#exhibition`;\nconst out = [{\n  json: {\n    _kind: 'summary',\n    status: 'success',\n    run_id: runId,\n    title: ex.title || '',\n    concept: ex.concept || '',\n    sections: sections.length,\n    halls_with_images: halls.filter(h => h.image_count > 0).length,\n    image_total: imageTotal,\n    halls,\n    museum_url: museumUrl,\n    halls_url: hallsUrl,\n    note: 'museum_url opens the 3D visit with corpus images on the walls. Next nodes download those images so they appear as Binary in this execution.',\n  },\n}];\nlet n = 0;\nfor (const h of halls) {\n  for (const img of h.images) {\n    if (n >= 8) break;\n    out.push({\n      json: {\n        _kind: 'image',\n        run_id: runId,\n        hall: h.hall,\n        hall_title: h.title,\n        title: img.title || `Oeuvre ${n + 1}`,\n        image_url: img.image_url,\n        museum_url: museumUrl,\n      },\n    });\n    n += 1;\n  }\n  if (n >= 8) break;\n}\nreturn out;"
      }
    },
    {
      "id": "ex-only-images",
      "name": "Only hall images",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [2160, 40],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-image",
              "leftValue": "={{ $json._kind }}",
              "rightValue": "image",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ex-download-img",
      "name": "Download museum images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 40],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.image_url }}",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "fullResponse": false,
              "responseFormat": "file",
              "outputPropertyName": "data",
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "ex-fail",
      "name": "Run failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1920, 220],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "run_id", "value": "={{ $json.run_id }}", "type": "string" },
            { "id": "2", "name": "error", "value": "={{ $json.error || 'no exhibition' }}", "type": "string" },
            { "id": "3", "name": "status", "value": "failed", "type": "string" }
          ]
        }
      }
    }
  ],
  "connections": {
    "Exhibition request": {
      "main": [[{ "node": "Start pipeline run", "type": "main", "index": 0 }]]
    },
    "Every Monday 09:00": {
      "main": [[{ "node": "Ingest new data (optional)", "type": "main", "index": 0 }]]
    },
    "Ingest new data (optional)": {
      "main": [[{ "node": "Start scheduled run", "type": "main", "index": 0 }]]
    },
    "Start pipeline run": {
      "main": [[{ "node": "Return run id", "type": "main", "index": 0 }]]
    },
    "Return run id": {
      "main": [[{ "node": "Run started?", "type": "main", "index": 0 }]]
    },
    "Start scheduled run": {
      "main": [[{ "node": "Run started?", "type": "main", "index": 0 }]]
    },
    "Run started?": {
      "main": [
        [{ "node": "Wait 60 s", "type": "main", "index": 0 }],
        [{ "node": "Run failed", "type": "main", "index": 0 }]
      ]
    },
    "Wait 60 s": {
      "main": [[{ "node": "Get run status", "type": "main", "index": 0 }]]
    },
    "Get run status": {
      "main": [[{ "node": "Still running?", "type": "main", "index": 0 }]]
    },
    "Still running?": {
      "main": [
        [{ "node": "Wait 60 s", "type": "main", "index": 0 }],
        [{ "node": "Exhibition written?", "type": "main", "index": 0 }]
      ]
    },
    "Exhibition written?": {
      "main": [
        [{ "node": "Exhibition summary", "type": "main", "index": 0 }],
        [{ "node": "Run failed", "type": "main", "index": 0 }]
      ]
    },
    "Exhibition summary": {
      "main": [[{ "node": "Only hall images", "type": "main", "index": 0 }]]
    },
    "Only hall images": {
      "main": [[{ "node": "Download museum images", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
